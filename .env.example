APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgres://postgres:synthetic-test-only@127.0.0.1:55438/textkeep_test
FIREBASE_PROJECT_ID=your-authentication-project
FIREBASE_WEB_CONFIG={"projectId":"your-project","appId":"your-web-app-id","apiKey":"public-client-key","authDomain":"your-project.firebaseapp.com"}
GOOGLE_APPLICATION_CREDENTIALS=/private/location/firebase-admin.json
ALLOWED_GOOGLE_EMAILS=owner@example.test
OWNER_FIREBASE_UID=
MESSAGE_ENCRYPTION_KEYRING={"v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
ACTIVE_MESSAGE_KEY_ID=v1
LOOKUP_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
OAUTH_JWKS={"keys":[]}
DATABASE_NETWORK=existing-private-network
PRIVATE_RUNTIME_DIRECTORY=/private/location/textkeep
